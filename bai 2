import React, { Component } from 'react';

class Clock extends Component {
  constructor(props) {
    super(props);
    this.state = {
      time: new Date().toLocaleTimeString(),
      clicks: 0,
    };
    console.log('Clock: constructor() được gọi');
  }

  componentDidMount() {
    console.log('Clock: componentDidMount() được gọi');
    this.timerID = setInterval(() => {
      this.setState({ time: new Date().toLocaleTimeString() });
    }, 1000);
  }

  componentDidUpdate(prevProps, prevState) {
    console.log('Clock: componentDidUpdate() được gọi');
    if (prevState.clicks !== this.state.clicks) {
      document.title = `Số lần bấm: ${this.state.clicks}`;
    }
  }

  componentWillUnmount() {
    console.log('Clock: componentWillUnmount() được gọi');
    clearInterval(this.timerID);
    document.title = 'React App'; 
  }

  handleClick = () => {
    this.setState((prevState) => ({
      clicks: prevState.clicks + 1,
    }));
  };

  render() {
    console.log('Clock: render() được gọi');
    return (
      <div style={{ border: '1px solid #ccc', padding: '15px', margin: '10px 0', borderRadius: '5px' }}>
        <h3>Đồng hồ thời gian thực</h3>
        <p>Thời gian hiện tại: {this.state.time}</p>
        <p>Số lần bấm: {this.state.clicks}</p>
        <button onClick={this.handleClick}>Tăng số lần bấm</button>
      </div>
    );
  }
}

class ClockContainer extends Component {
  state = { showClock: true };

  toggleClock = () => {
    this.setState((prevState) => ({ showClock: !prevState.showClock }));
  };

  render() {
    return (
      <div style={{ padding: '20px', fontFamily: 'Arial' }}>
        <h2>Bài 2: Đồng hồ & Lifecycle</h2>
        <button onClick={this.toggleClock} style={{ marginBottom: '10px' }}>
          {this.state.showClock ? 'Ẩn Clock' : 'Hiện Clock'}
        </button>
        {this.state.showClock && <Clock />}
      </div>
    );
  }
}

export default ClockContainer;
